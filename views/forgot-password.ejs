<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Forgot Password - RaptorScanner</title>

  <link rel="stylesheet" href="/style.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  >
</head>

<body class="auth-recovery-page">

  <div class="recovery-background" aria-hidden="true">
    <div class="recovery-grid"></div>
    <div class="recovery-glow recovery-glow-one"></div>
    <div class="recovery-glow recovery-glow-two"></div>
    <div class="recovery-scan-line"></div>

    <div class="recovery-binary recovery-binary-one">
      RECOVERY&nbsp;&nbsp;010101&nbsp;&nbsp;SECURE&nbsp;&nbsp;110010
    </div>

    <div class="recovery-binary recovery-binary-two">
      VERIFY&nbsp;&nbsp;101100&nbsp;&nbsp;RAPTOR&nbsp;&nbsp;011010
    </div>
  </div>

  <main class="recovery-shell">

    <section class="recovery-card">

      <a class="recovery-back" href="/login">
        <i class="fa-solid fa-arrow-left"></i>
        Back to login
      </a>

      <div class="recovery-icon">
        <i class="fa-solid fa-key"></i>
      </div>

      <p class="recovery-eyebrow">
        <i class="fa-solid fa-shield-halved"></i>
        Secure Account Recovery
      </p>

      <h1>Forgot Password?</h1>

      <p class="recovery-subtitle">
        Enter the email connected to your RaptorScanner account.
        We will send a secure reset link that expires in 15 minutes.
      </p>

      <% if (typeof error !== "undefined" && error) { %>
        <div class="recovery-alert recovery-alert-danger" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof success !== "undefined" && success) { %>
        <div class="recovery-alert recovery-alert-success" role="status">
          <i class="fa-solid fa-paper-plane"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <form
        id="forgotPasswordForm"
        action="/forgot-password"
        method="POST"
      >
        <div class="recovery-input-group">
          <label for="email">Email address</label>

          <div class="recovery-input-wrap">
            <i class="fa-regular fa-envelope"></i>

            <input
              id="email"
              type="email"
              name="email"
              value="<%= typeof email !== 'undefined' ? email : '' %>"
              placeholder="name@example.com"
              autocomplete="email"
              required
            >
          </div>
        </div>

        <button
          id="sendResetButton"
          class="recovery-primary-button"
          type="submit"
        >
          <span class="recovery-button-default">
            <i class="fa-solid fa-paper-plane"></i>
            Send Reset Link
          </span>

          <span class="recovery-button-loading">
            <span class="recovery-spinner"></span>
            Sending secure link...
          </span>
        </button>
      </form>

      <div class="recovery-note">
        <i class="fa-solid fa-circle-info"></i>

        <p>
          Check your inbox and spam folder for the email.
          For security, RaptorScanner uses a limited-time password reset link.
        </p>
      </div>

      <div class="recovery-footer">
        <span>
          <i class="fa-solid fa-lock"></i>
          Encrypted request
        </span>

        <span>
          <i class="fa-solid fa-clock"></i>
          15-minute link
        </span>
      </div>

    </section>

  </main>

  <script>
    const recoveryForm = document.getElementById("forgotPasswordForm");
    const resetButton = document.getElementById("sendResetButton");

    if (recoveryForm && resetButton) {
      recoveryForm.addEventListener("submit", () => {
        resetButton.classList.add("is-loading");
        resetButton.disabled = true;
      });
    }
  </script>

</body>
</html>