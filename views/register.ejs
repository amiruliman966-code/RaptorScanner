<!DOCTYPE html>
<html>
<head>
  <title>Register - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="logo">RaptorScanner</div>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/login">Login</a>
      <a href="/register">Sign Up</a>
      <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <!-- Register Page -->
  <main class="fb-login-page">

    <!-- Left Side Branding -->
    <section class="login-brand">
      <div class="logo-badge">🛡️</div>

      <h1>RaptorScanner</h1>

      <p>
        Create an account to upload files, scan URLs, generate hashes, and view
        your scan history securely.
      </p>
    </section>

    <!-- Right Side Register Box -->
    <section class="login-box">
      <h2>Create RaptorScanner Account</h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>

      <form action="/register" method="POST">
        <input 
          type="text" 
          name="name" 
          placeholder="Full Name" 
          required
        >

        <input 
          type="email" 
          name="email" 
          placeholder="Email address" 
          required
        >

        <input 
          type="password" 
          name="password" 
          placeholder="Password" 
          required
        >

        <button type="submit">Register</button>
      </form>

      <div class="divider">
        <span>or register with</span>
      </div>

      <div class="social-login">
        <a href="/auth/google" class="social-btn google">G</a>
      </div>

      <p>
        Already have an account?
        <a href="/login">Login here</a>
      </p>
    </section>

  </main>

  <script src="/theme.js"></script>
</body>
</html>