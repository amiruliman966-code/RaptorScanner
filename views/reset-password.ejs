<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/futuristic.css">
</head>
<body>

  <nav class="navbar">
    <div class="logo">RaptorScanner</div>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/login">Login</a>
      <a href="/register">Sign Up</a>
      <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <main class="fb-login-page">

    <section class="login-brand">
      <div class="logo-badge">🔑</div>

      <h1>Reset Password</h1>

      <p>
        Create a new password for your RaptorScanner account. This reset link is
        valid for a limited time only.
      </p>
    </section>

    <section class="login-box">
      <h2>Create New Password</h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>

      <form action="/reset-password/<%= token %>" method="POST">
        <input 
          type="password" 
          name="newPassword" 
          placeholder="New password" 
          required
        >

        <input 
          type="password" 
          name="confirmPassword" 
          placeholder="Confirm new password" 
          required
        >

        <button type="submit">Reset Password</button>
      </form>

      <a href="/login" class="create-account-btn">
        Back to Login
      </a>
    </section>

  </main>

  <script src="/theme.js"></script>
</body>
</html>
