<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/futuristic.css">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar login-navbar" id="loginNavbar">
    <div class="logo">RaptorScanner</div>

    <button type="button" class="nav-toggle" id="navToggle">☰</button>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/login">Login</a>
      <a href="/register">Sign Up</a>
      <button type="button" id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <!-- LOGIN PAGE -->
  <main class="login-responsive-page">

    <!-- LEFT BRAND BOX -->
    <section class="login-brand">
      <div class="logo-badge">🛡️</div>

      <h1>RaptorScanner</h1>

      <p>
        Scan files, check URLs, generate hashes, and view simple malware risk
        reports before opening suspicious files.
      </p>
    </section>

    <!-- RIGHT LOGIN BOX -->
    <section class="login-box">
      <h2>Log in to RaptorScanner</h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>

      <form action="/login" method="POST">
        <input 
          type="email" 
          name="email" 
          placeholder="Email address" 
          required
        >

        <div class="login-password-field">
          <input
            id="loginPassword"
            type="password"
            name="password"
            placeholder="Password"
            autocomplete="current-password"
            required
          >
          <button
            type="button"
            class="login-password-toggle"
            aria-label="Show password"
            aria-pressed="false"
            data-login-password-toggle
          >
            <svg class="login-eye-closed" data-eye-closed viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 3l18 18"></path>
              <path d="M10.6 10.7a2 2 0 0 0 2.7 2.7"></path>
              <path d="M9.9 4.2A10.7 10.7 0 0 1 12 4c5.5 0 9 8 9 8a16.8 16.8 0 0 1-2.1 3.2"></path>
              <path d="M6.6 6.6C4.2 8.2 3 12 3 12s3.5 8 9 8a9.7 9.7 0 0 0 4.1-.9"></path>
            </svg>
            <svg class="login-eye-open" data-eye-open viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 12s3.5-8 9-8 9 8 9 8-3.5 8-9 8-9-8-9-8z"></path>
              <circle cx="12" cy="12" r="2.5"></circle>
            </svg>
          </button>
        </div>

        <div class="forgot-password-wrap">
          <a href="/forgot-password" class="forgot-password-link">
            Forgot password?
          </a>
        </div>

        <button type="submit">Log in</button>
      </form>

      <div class="divider">
        <span>or login with</span>
      </div>

      <div class="social-login">
        <a href="/auth/google" class="social-btn google">G</a>
      </div>

      <a href="/register" class="create-account-btn">
        Create new account
      </a>
    </section>

  </main>

  <script src="/theme.js"></script>
  <script>
    const loginPassword = document.getElementById("loginPassword");
    const loginPasswordToggle = document.querySelector("[data-login-password-toggle]");

    if (loginPassword && loginPasswordToggle) {
      loginPasswordToggle.addEventListener("click", () => {
        const showPassword = loginPassword.type === "password";
        loginPassword.type = showPassword ? "text" : "password";
        loginPasswordToggle.setAttribute("aria-pressed", String(showPassword));
        loginPasswordToggle.setAttribute(
          "aria-label",
          showPassword ? "Hide password" : "Show password"
        );
        const closedEye = loginPasswordToggle.querySelector("[data-eye-closed]");
        const openEye = loginPasswordToggle.querySelector("[data-eye-open]");

        closedEye.style.display = showPassword ? "none" : "block";
        openEye.style.display = showPassword ? "block" : "none";
        loginPassword.focus();
      });
    }
  </script>
</body>
</html>
