<!DOCTYPE html>
<html>
<head>
  <title>Login - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="logo">RaptorScanner</div>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/login">Login</a>
      <a href="/register">Sign Up</a>
      <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <!-- Login Page -->
  <main class="fb-login-page">

    <!-- Left Side Branding -->
    <section class="login-brand">
      <div class="logo-badge">🛡️</div>

      <h1>RaptorScanner</h1>

      <p>
        Scan files, check URLs, generate hashes, and view simple malware risk
        reports before opening suspicious files.
      </p>
    </section>

    <!-- Right Side Login Box -->
    <section class="login-box">
      <h2>Log in to RaptorScanner</h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>

      <form action="/login" method="POST">
        <input 
          type="email" 
          name="email" 
          placeholder="Email address" 
          required
        >

        <input 
          type="password" 
          name="password" 
          placeholder="Password" 
          required
        >

        <div class="forgot-password-wrap">
          <a href="/forgot-password" class="forgot-password-link">
            Forgot password?
          </a>
        </div>

        <button type="submit">Log in</button>
      </form>

      <div class="divider">
        <span>or login with</span>
      </div>

      <div class="social-login">
        <a href="/auth/google" class="social-btn google">G</a>
      </div>

      <a href="/register" class="create-account-btn">
        Create new account
      </a>
    </section>

  </main>

  <script src="/theme.js"></script>
</body>
</html>