<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URL Scan Result - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <nav class="navbar" id="dashboardNavbar">

    <div class="nav-left">
      <a href="/profile" class="navbar-profile-link" title="Open Profile">
        <% 
          let profilePic = null;

          if (user && user.profile_picture) {
            if (user.profile_picture.startsWith("/")) {
              profilePic = user.profile_picture;
            } else if (user.profile_picture.startsWith("uploads/")) {
              profilePic = "/" + user.profile_picture;
            } else {
              profilePic = "/uploads/" + user.profile_picture;
            }
          }
        %>

        <% if (profilePic) { %>
          <img src="<%= profilePic %>" alt="Profile" class="navbar-profile-img">
        <% } else { %>
          <div class="navbar-profile-initial">
            <%= user && user.name ? user.name.charAt(0).toUpperCase() : "U" %>
          </div>
        <% } %>
      </a>

      <div class="logo">RaptorScanner</div>
    </div>

    <button type="button" class="nav-toggle" id="navToggle">☰</button>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/history">Scan History</a>
      <a href="/profile">Profile</a>

      <% if (user && user.role === "admin") { %>
        <a href="/admin">Admin</a>
      <% } %>

      <a href="/logout">Logout</a>
      <button type="button" id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <% 
    const resultData = typeof urlResult !== "undefined" && urlResult ? urlResult : {};
    const resultUrl = typeof url !== "undefined" ? url : (resultData.url || "Not available");
    const resultDomain = resultData.domain || "Not available";
    const resultProtocol = resultData.protocol || "Not available";
    const resultRisk = resultData.riskLevel || resultData.risk_level || "Low";
    const resultScan = resultData.scanResult || resultData.scan_result || "Unknown";
    const resultReason = resultData.reason || "No reason provided.";
  %>

  <main class="result-container">
    <h1>URL Scan Result</h1>

    <div class="card">
      <h2>URL Information</h2>

      <p><strong>URL:</strong></p>
      <div class="hash"><%= resultUrl %></div>

      <p><strong>Domain:</strong> <%= resultDomain %></p>
      <p><strong>Protocol:</strong> <%= resultProtocol %></p>
      <p><strong>Status:</strong> <%= resultScan %></p>

      <p>
        <strong>Risk Level:</strong>

        <% if (resultRisk === "High") { %>
          <span class="badge high">High</span>
        <% } else if (resultRisk === "Medium") { %>
          <span class="badge medium">Medium</span>
        <% } else { %>
          <span class="badge low">Low</span>
        <% } %>
      </p>

      <p><strong>Reason:</strong> <%= resultReason %></p>
    </div>

    <div class="result-actions">
      <a href="/dashboard" class="btn">Back to Dashboard</a>
      <a href="/history" class="btn">View Scan History</a>
    </div>
  </main>

  <script src="/theme.js"></script>
</body>
</html>
