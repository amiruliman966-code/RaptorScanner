<!DOCTYPE html>
<html>
<head>
  <title>Search Result - RaptorScanner</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <nav class="navbar">
    <div class="logo">RaptorScanner</div>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/history">Scan History</a>
      <a href="/logout">Logout</a>
      <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <div class="result-container">
    <h1>Search Result</h1>

    <div class="card">
      <p><strong>Search Query:</strong> <%= query %></p>
      <p><strong>Detected Type:</strong> <%= searchType %></p>
    </div>

    <% if (
      searchType === "MD5 Hash" ||
      searchType === "SHA-1 Hash" ||
      searchType === "SHA-256 Hash"
    ) { %>

      <div class="card">
        <h2>File Results</h2>

        <% if (fileResults.length === 0) { %>
          <p>No file result found in local database.</p>
        <% } else { %>
          <% fileResults.forEach((file) => { %>
            <p><strong>File:</strong> <%= file.original_name %></p>

            <p><strong>MD5:</strong></p>
            <p class="hash"><%= file.md5_hash %></p>

            <p><strong>SHA-1:</strong></p>
            <p class="hash"><%= file.sha1_hash %></p>

            <p><strong>SHA-256:</strong></p>
            <p class="hash"><%= file.sha256_hash %></p>

            <p><strong>Scan Result:</strong> <%= file.scan_result %></p>
            <p><strong>Risk Level:</strong> <%= file.risk_level %></p>

            <hr>
          <% }) %>
        <% } %>
      </div>

    <% } else { %>

      <div class="card">
        <h2>URL / Domain / IP Results</h2>

        <% if (urlResults.length === 0) { %>
          <p>No URL, domain, or IP result found in local database.</p>
        <% } else { %>
          <% urlResults.forEach((item) => { %>
            <p><strong>URL:</strong> <%= item.url %></p>
            <p><strong>Domain:</strong> <%= item.domain %></p>
            <p><strong>Protocol:</strong> <%= item.protocol %></p>
            <p><strong>Status:</strong> <%= item.scan_result %></p>

            <% if (item.risk_level === "High") { %>
              <p class="risk-high"><strong>Risk Level:</strong> <%= item.risk_level %></p>
            <% } else if (item.risk_level === "Medium") { %>
              <p class="risk-medium"><strong>Risk Level:</strong> <%= item.risk_level %></p>
            <% } else { %>
              <p class="risk-low"><strong>Risk Level:</strong> <%= item.risk_level %></p>
            <% } %>

            <p><strong>Reason:</strong> <%= item.reason %></p>

            <hr>
          <% }) %>
        <% } %>
      </div>

    <% } %>

    <a class="btn" href="/dashboard">Back to Dashboard</a>
  </div>

  <script src="/theme.js"></script>
</body>
</html>