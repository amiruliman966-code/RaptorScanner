<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scan Result - RaptorScanner</title>

  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/futuristic.css">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar" id="dashboardNavbar">
    <div class="logo">RaptorScanner</div>

    <button type="button" class="nav-toggle" id="navToggle">☰</button>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/history">Scan History</a>

      <% if (user && user.role === "admin") { %>
        <a href="/admin">Admin</a>
      <% } %>

      <a href="/logout">Logout</a>
      <%- include("partials/profile-avatar") %>
      <button type="button" id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <!-- SCAN RESULT PAGE -->
  <main class="scan-result-page">

    <section class="scan-report-card">

      <div class="scan-report-header">
        <h1>RaptorScanner Report</h1>
        <p>Mini VirusTotal-style file analysis result</p>
      </div>

      <!-- FILE INFORMATION -->
      <div class="report-section">
        <h2>File Information</h2>

        <div class="report-row">
          <strong>Original File Name:</strong>
          <span><%= file.originalname %></span>
        </div>

        <div class="report-row">
          <strong>Stored File Name:</strong>
          <span><%= file.filename %></span>
        </div>

        <div class="report-row">
          <strong>File Size:</strong>
          <span><%= (file.size / 1024).toFixed(2) %> KB</span>
        </div>
      </div>

      <!-- HASH VALUES -->
      <div class="report-section">
        <h2>Hash Values</h2>

        <div class="hash-box">
          <label>MD5:</label>
          <div class="hash-copy-row">
            <code><%= md5Hash %></code>
            <button type="button" onclick="copyText('<%= md5Hash %>')">
              Copy
            </button>
          </div>
        </div>

        <div class="hash-box">
          <label>SHA-1:</label>
          <div class="hash-copy-row">
            <code><%= sha1Hash %></code>
            <button type="button" onclick="copyText('<%= sha1Hash %>')">
              Copy
            </button>
          </div>
        </div>

        <div class="hash-box">
          <label>SHA-256:</label>
          <div class="hash-copy-row">
            <code><%= sha256Hash %></code>
            <button type="button" onclick="copyText('<%= sha256Hash %>')">
              Copy
            </button>
          </div>
        </div>
      </div>

      <!-- SCAN RESULT -->
      <div class="report-section">
        <h2>Scan Result</h2>

        <div class="report-row">
          <strong>Status:</strong>
          <span><%= scanResult %></span>
        </div>

        <% if (riskLevel === "High") { %>
          <span class="risk-badge high">Risk Level: High</span>
        <% } else if (riskLevel === "Medium") { %>
          <span class="risk-badge medium">Risk Level: Medium</span>
        <% } else { %>
          <span class="risk-badge low">Risk Level: Low</span>
        <% } %>
      </div>

      <!-- RECOMMENDATION -->
      <div class="report-section">
        <h2>Recommendation</h2>

        <% if (riskLevel === "High") { %>
          <p>
            This file is considered high risk. Do not open it unless you are sure it is safe.
          </p>
        <% } else if (riskLevel === "Medium") { %>
          <p>
            This file has some suspicious characteristics. Be careful before opening it.
          </p>
        <% } else { %>
          <p>
            This file appears to be low risk based on basic file analysis.
          </p>
        <% } %>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="report-actions">
        <a href="/dashboard" class="btn">Scan Another File</a>
        <a href="/history" class="btn">View History</a>
        <a href="/logout" class="btn danger-btn">Logout</a>
      </div>

    </section>

  </main>

  <script>
    function copyText(text) {
      navigator.clipboard.writeText(text);
      alert("Copied to clipboard");
    }
  </script>

  <script src="/theme.js"></script>
</body>
</html>
